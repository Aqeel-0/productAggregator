{
  "name": "aggremart",
  "version": "1.0.0",
  "description": "AggreMart: The Intelligent Product Discovery & Comparison Engine",
  "main": "src/app.js",
  "scripts": {
    "start": "node src/app.js",
    "dev": "nodemon src/app.js",
    "db:migrate": "npx sequelize-cli db:migrate",
    "db:seed": "npx sequelize-cli db:seed:all",
    "db:reset": "npx sequelize-cli db:drop && npx sequelize-cli db:create && npm run db:migrate && npm run db:seed",
    "lint": "eslint src/ tests/ --fix",
    "lint:check": "eslint src/ tests/"
  },
  "keywords": [
    "ecommerce",
    "product-aggregator",
    "price-comparison",
    "scraping",
    "nodejs",
    "express"
  ],
  "author": "AggreMart Team",
  "license": "MIT",
  "dependencies": {
    "@google-cloud/cloud-sql-connector": "^1.2.3",
    "@google-cloud/storage": "^7.16.0",
    "@google/generative-ai": "^0.24.1",
    "@supabase/supabase-js": "^2.83.0",
    "axios": "^1.13.2",
    "bull": "^4.16.5",
    "cheerio": "^1.1.2",
    "cors": "^2.8.5",
    "cron": "^3.2.0",
    "dotenv": "^16.6.1",
    "express": "^4.21.2",
    "fastest-levenshtein": "^1.0.16",
    "fuzzball": "^2.2.2",
    "helmet": "^8.1.0",
    "joi": "^17.13.3",
    "knex": "^3.1.0",
    "mongodb": "^7.0.0",
    "morgan": "^1.10.1",
    "openai": "^6.9.1",
    "pg": "^8.13.1",
    "pg-hstore": "^2.3.4",
    "puppeteer": "^24.30.0",
    "puppeteer-cluster": "^0.25.0",
    "puppeteer-extra": "^3.3.6",
    "puppeteer-extra-plugin-stealth": "^2.11.2",
    "redis": "^5.9.0",
    "sequelize": "^6.37.7",
    "user-agents": "^1.1.0",
    "uuid": "^11.0.3",
    "winston": "^3.18.3"
  },
  "devDependencies": {
    "@babel/core": "^7.28.5",
    "@babel/preset-env": "^7.26.0",
    "babel-jest": "^30.2.0",
    "eslint": "^9.39.1",
    "eslint-config-prettier": "^9.1.0",
    "jest": "^30.2.0",
    "jest-html-reporters": "^3.1.7",
    "jest-sonar-reporter": "^2.0.0",
    "jest-watch-typeahead": "^3.0.1",
    "nodemon": "^3.1.9",
    "prettier": "^3.4.2",
    "sequelize-cli": "^6.6.2",
    "supertest": "^7.1.4"
  },
  "engines": {
    "node": ">=18.0.0",
    "npm": ">=9.0.0"
  }
}
